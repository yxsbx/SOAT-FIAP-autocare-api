root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.java]
indent_style = space
indent_size = 4
tab_width = 4
ij_continuation_indent_size = 8
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
ij_java_layout_static_imports_separately = true
ij_java_imports_layout = $*, |, java.**, |, javax.**, |, org.**, |, com.**, |, br.**

[*.{xml,xsd}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2
tab_width = 2

[*.json]
indent_style = space
indent_size = 2
tab_width = 2

[*.{properties,env}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2
tab_width = 2

[*.vue]
indent_style = space
indent_size = 2
tab_width = 2

[*.{css,scss,sass,less}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{html,htm}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[Dockerfile]
indent_style = space
indent_size = 2
tab_width = 2

[*.sql]
indent_style = space
indent_size = 4
tab_width = 4
